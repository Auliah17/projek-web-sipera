<?php
session_start();
require_once __DIR__ . '/../../../config/database.php';

if (!isset($_SESSION['user_id']) || $_SESSION['role'] !== 'admin') {
    exit("Unauthorized");
}

$stmt = $conn->prepare("
    SELECT a.id, u.nama, a.subjek, a.tanggal, a.status, a.role_pengirim 
    FROM aduan a
    JOIN users u ON a.id_pengirim = u.id
    ORDER BY a.tanggal DESC
");
$stmt->execute();
$result = $stmt->get_result();

if ($result->num_rows > 0):
    while ($aduan = $result->fetch_assoc()):
?>
<tr>
    <td><?= htmlspecialchars($aduan['nama']) ?></td>
    <td><?= ucfirst(htmlspecialchars($aduan['role_pengirim'])) ?></td>
    <td><?= htmlspecialchars($aduan['subjek']) ?></td>
    <td><?= date('d M Y H:i', strtotime($aduan['tanggal'])) ?></td>
    <td><?= htmlspecialchars($aduan['status']) ?></td>
    <td><a class="detail-link" href="detail_aduan_admin.php?id=<?= $aduan['id'] ?>">Buka Chat</a></td>
</tr>
<?php
    endwhile;
else:
?>
<tr><td colspan="6" style="text-align:center;">Belum ada aduan dari pengguna.</td></tr>
<?php
endif;
?>
